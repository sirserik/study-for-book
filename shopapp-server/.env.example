# Скопируй в .env и поправь под себя.
# Порт 5433, а не 5432 — чтобы не спорить с PostgreSQL, который уже может
# крутиться на маке (см. главу 31.3).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shopapp?schema=public"
JWT_SECRET=my-very-long-random-string-for-signing-tokens
PORT=3000
